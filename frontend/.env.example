# Base URL of the Calculator API.
#
# Defaults to "/api/v1", which works both for `npm run dev` (the Vite dev server
# proxies /api to http://localhost:8080) and for production, where the Go binary
# serves this SPA and the API from the same origin.
#
# Point it at an absolute URL only when the API lives somewhere else, e.g.:
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1
